{
  "name": "android-agent-lab",
  "productName": "Android Agent Lab",
  "desktopName": "android-agent-lab",
  "version": "0.3.1",
  "description": "Shared Android devices, scrcpy video, and visible agent cursors on your desktop.",
  "main": "app/main.cjs",
  "author": {
    "name": "Hashim",
    "url": "https://github.com/hashimkarim"
  },
  "homepage": "https://github.com/hashimkarim/android-agent-lab",
  "repository": {
    "type": "git",
    "url": "https://github.com/hashimkarim/android-agent-lab.git"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "node start.cjs",
    "prepare-runtime": "python3 ../scripts/prepare_desktop.py",
    "build": "electron-builder --config electron-builder.yml --publish never",
    "test": "node --test test/*.test.cjs",
    "test:ui": "node test/workspace.e2e.cjs && node test/projects.e2e.cjs && node test/viewer.e2e.cjs"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "playwright": "1.63.0"
  },
  "dependencies": {
    "qrcode": "1.5.4"
  }
}
