#!/usr/bin/make -f

include /usr/share/dpkg/architecture.mk
include /usr/share/dpkg/pkg-info.mk
VERSION := $(shell dpkg-parsechangelog -S Version | cut -d- -f1)
BUNDLE_ARCH := $(if $(filter arm64,$(DEB_HOST_ARCH)),arm64,x64)
DEST := debian/android-agent-lab

%:
	dh $@

override_dh_auto_configure:

override_dh_auto_build:

override_dh_auto_test:
	cd prebuilt && sha256sum --check SHA256SUMS

override_dh_auto_install:
	install -d $(DEST)/opt/android-agent-lab
	tar -xzf prebuilt/Android-Agent-Lab-$(VERSION)-$(BUNDLE_ARCH).tar.gz --strip-components=1 -C $(DEST)/opt/android-agent-lab
	install -Dm755 packaging/common/android-agent-lab $(DEST)/usr/bin/android-agent-lab
	install -Dm644 packaging/common/android-agent-lab.desktop $(DEST)/usr/share/applications/android-agent-lab.desktop
	install -Dm644 packaging/common/android-agent-lab.png $(DEST)/usr/share/icons/hicolor/256x256/apps/android-agent-lab.png
	dh_apparmor --profile-name=android-agent-lab
	# Upstream uses epoch-zero directories for reproducible staging; Launchpad
	# rejects them. Normalize metadata to the release date without changing bytes.
	find $(DEST) -exec touch --no-dereference --date="@$(SOURCE_DATE_EPOCH)" {} +

override_dh_fixperms:
	dh_fixperms
	chmod 4755 $(DEST)/opt/android-agent-lab/chrome-sandbox

override_dh_strip:

override_dh_dwz:

override_dh_shlibdeps:
# Dependencies are explicit: scanning Electron's private libraries creates
# incorrect dependencies on libraries which are shipped inside the bundle.

override_dh_usrlocal:

override_dh_auto_clean:
