# scripts/lab.py init creates a random VNC password. VNC uses at most 8 characters.
VNC_PASSWORD=changeMe
WEB_PORT=8765
ADB_PORT=15555
EMULATOR_ARGS=-no-snapshot -no-audio -no-boot-anim -no-metrics -screen multi-touch -gpu lavapipe -feature -ModemSimulator,GLDirectMem,HasSharedSlotsHostMemoryAllocator
